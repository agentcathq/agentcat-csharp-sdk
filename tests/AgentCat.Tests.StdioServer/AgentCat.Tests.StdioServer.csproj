<Project Sdk="Microsoft.NET.Sdk">
  <!-- A real MCP server for the stdio end-to-end lanes. The test project runs it with `dotnet <this>.dll`. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
  <ItemGroup Condition="'$(McpTestVersion)' != ''">
    <PackageReference Include="ModelContextProtocol" VersionOverride="$(McpTestVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/AgentCat/AgentCat.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../AgentCat.Tests/E2E/Scenarios.cs" Link="E2E/Scenarios.cs" />
    <Compile Include="../AgentCat.Tests/E2E/E2EToolkit.cs" Link="E2E/E2EToolkit.cs" />
    <Compile Include="../AgentCat.Tests/E2E/E2EExporters.cs" Link="E2E/E2EExporters.cs" />
  </ItemGroup>
</Project>
