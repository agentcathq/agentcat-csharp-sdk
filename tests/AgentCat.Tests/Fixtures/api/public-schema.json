{
    "openapi": "3.0.3",
    "info": {
        "title": "AgentCat API",
        "version": "v1",
        "description": "API for AgentCat application"
    },
    "paths": {
        "/v1/public/alerts/unsubscribe": {
            "get": {
                "operationId": "unsubscribe_alert_get",
                "description": "GET, the link in the email, shows a confirmation page and changes nothing, because\nmail scanners fetch links. POST removes the address from the rule; the page's form and\nthe List-Unsubscribe-Post header both send it. POST is idempotent.",
                "summary": "Show the confirmation page for removing an email address from one alert rule",
                "parameters": [
                    {
                        "in": "query",
                        "name": "token",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "tags": [
                    "Alerts"
                ],
                "security": [
                    {}
                ],
                "responses": {
                    "200": {
                        "content": {
                            "text/html": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        },
                        "description": ""
                    },
                    "400": {
                        "content": {
                            "text/plain": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        },
                        "description": ""
                    },
                    "401": {
                        "description": "Authentication credentials missing or invalid.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Authenticated user lacks permission for this resource.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "operationId": "unsubscribe_alert_post",
                "description": "GET, the link in the email, shows a confirmation page and changes nothing, because\nmail scanners fetch links. POST removes the address from the rule; the page's form and\nthe List-Unsubscribe-Post header both send it. POST is idempotent.",
                "summary": "Remove an email address from one alert rule (List-Unsubscribe-Post and the confirmation form)",
                "parameters": [
                    {
                        "in": "query",
                        "name": "token",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "tags": [
                    "Alerts"
                ],
                "security": [
                    {}
                ],
                "responses": {
                    "200": {
                        "content": {
                            "text/plain": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        },
                        "description": ""
                    },
                    "400": {
                        "content": {
                            "text/plain": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        },
                        "description": ""
                    },
                    "401": {
                        "description": "Authentication credentials missing or invalid.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Authenticated user lacks permission for this resource.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/v1/public/events/": {
            "post": {
                "operationId": "publishEvent",
                "description": "Submit analytics events for a project. Returns immediately with 202 Accepted.",
                "summary": "Publish analytics event",
                "tags": [
                    "Events"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "project_id"
                                ],
                                "properties": {
                                    "id": {
                                        "type": "string",
                                        "description": "ID of the event, typically auto-generated by the AgentCat Agent"
                                    },
                                    "project_id": {
                                        "type": "string",
                                        "description": "ID of the project this event belongs to"
                                    },
                                    "session_id": {
                                        "type": "string",
                                        "nullable": true,
                                        "description": "ID of the session this event belongs to. Null for stateless mode (server assigns session)."
                                    },
                                    "actor_id": {
                                        "type": "string",
                                        "description": "Optional actor ID"
                                    },
                                    "event_id": {
                                        "type": "string",
                                        "description": "Optional custom event ID (must be unique)"
                                    },
                                    "event_type": {
                                        "type": "string",
                                        "description": "Type of event (e.g., mcp:tools/call, agentcat:identify)",
                                        "enum": [
                                            "mcp:ping",
                                            "mcp:initialize",
                                            "mcp:completion/complete",
                                            "mcp:logging/setLevel",
                                            "mcp:prompts/get",
                                            "mcp:prompts/list",
                                            "mcp:resources/list",
                                            "mcp:resources/templates/list",
                                            "mcp:resources/read",
                                            "mcp:resources/subscribe",
                                            "mcp:resources/unsubscribe",
                                            "mcp:tools/call",
                                            "mcp:tools/list",
                                            "mcp:tasks/get",
                                            "mcp:tasks/result",
                                            "mcp:tasks/list",
                                            "mcp:tasks/cancel",
                                            "agentcat:identify",
                                            "agentcat:custom"
                                        ]
                                    },
                                    "is_error": {
                                        "type": "boolean",
                                        "description": "Whether this event represents an error"
                                    },
                                    "error": {
                                        "type": "object",
                                        "description": "Error details if is_error is true"
                                    },
                                    "resource_name": {
                                        "type": "string",
                                        "description": "Name of the resource accessed (for resource events)"
                                    },
                                    "duration": {
                                        "type": "integer",
                                        "description": "Duration of the operation in milliseconds"
                                    },
                                    "input_tokens": {
                                        "type": "integer",
                                        "description": "Token count of the request side as measured by the SDK. When absent, the server estimates it from the stored parameters."
                                    },
                                    "output_tokens": {
                                        "type": "integer",
                                        "description": "Token count of the response side as measured by the SDK. When absent, the server estimates it from the stored response. Drives the oversized-tool-response rule."
                                    },
                                    "timestamp": {
                                        "type": "string",
                                        "format": "date-time",
                                        "description": "Agent-provided timestamp of when the event occurred"
                                    },
                                    "user_intent": {
                                        "type": "string",
                                        "description": "Captured explanation of why the actor made this request"
                                    },
                                    "parameters": {
                                        "type": "object",
                                        "description": "Parameters sent with the request"
                                    },
                                    "response": {
                                        "type": "object",
                                        "description": "Response data from the operation"
                                    },
                                    "identify_actor_given_id": {
                                        "type": "string",
                                        "description": "Actor ID for agentcat:identify events"
                                    },
                                    "identify_actor_name": {
                                        "type": "string",
                                        "description": "Actor name for agentcat:identify events"
                                    },
                                    "identify_data": {
                                        "type": "object",
                                        "description": "Additional data for agentcat:identify events"
                                    },
                                    "tags": {
                                        "type": "object",
                                        "additionalProperties": {
                                            "type": "string"
                                        },
                                        "description": "Custom string key-value pairs. Keys: max 32 chars, alphanumeric/underscore/period/colon/dash/dollar-sign only. Values: max 200 chars, no newlines. Max 50 entries."
                                    },
                                    "properties": {
                                        "type": "object",
                                        "description": "Custom structured data. Keys are strings, values can be string, number, boolean, array, object, or null (null values are filtered out)."
                                    },
                                    "ip_address": {
                                        "type": "string",
                                        "format": "ipv4",
                                        "description": "IP address of the client"
                                    },
                                    "sdk_language": {
                                        "type": "string",
                                        "description": "Programming language of the SDK used"
                                    },
                                    "agentcat_version": {
                                        "type": "string",
                                        "description": "Version of AgentCat being used"
                                    },
                                    "server_name": {
                                        "type": "string",
                                        "description": "Name of the MCP server"
                                    },
                                    "server_version": {
                                        "type": "string",
                                        "description": "Version of the MCP server"
                                    },
                                    "client_name": {
                                        "type": "string",
                                        "description": "Name of the MCP client"
                                    },
                                    "client_version": {
                                        "type": "string",
                                        "description": "Version of the MCP client"
                                    }
                                },
                                "additionalProperties": true,
                                "example": {
                                    "id": "evt_789",
                                    "project_id": "proj_123",
                                    "session_id": "ses_456",
                                    "event_type": "mcp:tools/call",
                                    "resource_name": "calculator",
                                    "timestamp": "2025-06-02T12:00:00Z",
                                    "duration": 150,
                                    "user_intent": "Calculate the sum of two numbers",
                                    "parameters": {
                                        "tool": "calculator",
                                        "operation": "add",
                                        "values": [
                                            5,
                                            10
                                        ]
                                    },
                                    "response": {
                                        "result": 15
                                    },
                                    "tags": {
                                        "env": "production",
                                        "trace_id": "abc-123-def"
                                    },
                                    "properties": {
                                        "device": "mobile",
                                        "app_version": "2.1.0",
                                        "feature_flags": [
                                            "dark_mode",
                                            "beta_ui"
                                        ]
                                    },
                                    "ip_address": "192.168.1.1",
                                    "sdk_language": "python",
                                    "agentcat_version": "1.0.0",
                                    "server_name": "calculator-mcp-server",
                                    "server_version": "2.1.0",
                                    "client_name": "Claude Desktop",
                                    "client_version": "3.0.0"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "tokenAuth": []
                    },
                    {}
                ],
                "responses": {
                    "202": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/EventAcceptedResponse"
                                }
                            }
                        },
                        "description": ""
                    },
                    "400": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "description": "Invalid request data"
                                }
                            }
                        },
                        "description": ""
                    },
                    "404": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "description": "Project not found"
                                }
                            }
                        },
                        "description": ""
                    },
                    "401": {
                        "description": "Authentication credentials missing or invalid.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Authenticated user lacks permission for this resource.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/v1/public/notifications/channels/verify": {
            "post": {
                "operationId": "verify_email_channel",
                "summary": "Activate an email channel from its verification link",
                "parameters": [
                    {
                        "in": "query",
                        "name": "token",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "tags": [
                    "Notifications"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/EmailChannelVerifyRequest"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/EmailChannelVerifyRequest"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/EmailChannelVerifyRequest"
                            }
                        }
                    }
                },
                "security": [
                    {}
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/EmailChannelVerifyResponse"
                                }
                            }
                        },
                        "description": ""
                    },
                    "400": {
                        "description": "Invalid request input.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationError"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Authentication credentials missing or invalid.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Authenticated user lacks permission for this resource.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/v1/public/notifications/unsubscribe": {
            "post": {
                "operationId": "unsubscribe_notification",
                "description": "Anonymous endpoint reached from email unsubscribe links and the List-Unsubscribe header POST. The token encodes the user and the notification type to disable. Response bodies are plain text.",
                "summary": "Disable an email notification type for the token's user",
                "parameters": [
                    {
                        "in": "query",
                        "name": "token",
                        "schema": {
                            "type": "string"
                        },
                        "description": "Signed unsubscribe token. May also be passed in the request body."
                    }
                ],
                "tags": [
                    "Notifications"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UnsubscribeRequestRequest"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/UnsubscribeRequestRequest"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/UnsubscribeRequestRequest"
                            }
                        }
                    }
                },
                "security": [
                    {}
                ],
                "responses": {
                    "200": {
                        "content": {
                            "text/plain": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        },
                        "description": ""
                    },
                    "400": {
                        "content": {
                            "text/plain": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        },
                        "description": ""
                    },
                    "404": {
                        "content": {
                            "text/plain": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        },
                        "description": ""
                    },
                    "401": {
                        "description": "Authentication credentials missing or invalid.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Authenticated user lacks permission for this resource.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "EmailChannelVerifyRequest": {
                "type": "object",
                "properties": {
                    "token": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            },
            "EmailChannelVerifyResponse": {
                "type": "object",
                "properties": {
                    "success": {
                        "type": "boolean"
                    },
                    "channel_id": {
                        "type": "string"
                    }
                },
                "required": [
                    "channel_id",
                    "success"
                ]
            },
            "EventAcceptedResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "default": "accepted"
                    }
                }
            },
            "UnsubscribeRequestRequest": {
                "type": "object",
                "properties": {
                    "token": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            },
            "Error": {
                "type": "object",
                "required": [
                    "detail"
                ],
                "properties": {
                    "detail": {
                        "type": "string"
                    }
                }
            },
            "ValidationError": {
                "type": "object",
                "description": "Field-level validation error. Keys are field names; values are either a single error message or an array of messages.",
                "additionalProperties": {
                    "oneOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    ]
                }
            },
            "QueryTimeout": {
                "type": "object",
                "required": [
                    "detail",
                    "code"
                ],
                "properties": {
                    "detail": {
                        "type": "string"
                    },
                    "code": {
                        "type": "string",
                        "enum": [
                            "query_timeout"
                        ]
                    }
                }
            }
        },
        "securitySchemes": {
            "oauth2": {
                "type": "oauth2",
                "flows": {}
            },
            "tokenAuth": {
                "type": "apiKey",
                "in": "header",
                "name": "Authorization",
                "description": "Token-based authentication with required prefix \"Token\""
            }
        }
    },
    "servers": [
        {
            "url": "https://api.agentcat.com",
            "description": "Local server"
        }
    ]
}